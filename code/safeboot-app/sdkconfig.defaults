# ESPurna safeboot: small, no logs, Wi-Fi station (WPA2/WPA3) + soft AP, the HTTP server and client are ESPurna's
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../esp32_4mb_safeboot.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_MAXIMUM_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_ERR_TO_NAME_LOOKUP=y
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_IPV4=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_WPS_SOFTAP_REGISTRAR=n
CONFIG_ESP_WIFI_WPS_PASSPHRASE=n
CONFIG_ESP_WIFI_ENABLE_ROAMING_APP=n
CONFIG_ESP_WIFI_NAN_ENABLE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# TLS: BearSSL of the one HTTP client of ESPurna (espurna/libs/http_client.h). mbedTLS only for the crypto of the Wi-Fi
# (WPA3 SAE): its TLS part and the certificate bundle are off
CONFIG_MBEDTLS_TLS_DISABLED=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
CONFIG_BT_ENABLED=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# an image written into app0 (/upload, /boot) is "new": the bootloader (Arduino's, rollback on) starts it once and comes
# back here unless ESPurna confirms it (arch/esp32/safeboot_esp32.cpp)
CONFIG_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
